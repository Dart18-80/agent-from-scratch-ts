# Copy to .env and fill in the values you need. Never commit .env.

# Which provider the agent talks to: mock | anthropic | ollama
# "mock" needs no API key and is what `pnpm demo` uses.
LLM_PROVIDER=mock

# Model name for the chosen provider (e.g. a Claude model id, or an Ollama model tag).
# Left empty on purpose: model names are never hardcoded in the source.
LLM_MODEL=

# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required only when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
